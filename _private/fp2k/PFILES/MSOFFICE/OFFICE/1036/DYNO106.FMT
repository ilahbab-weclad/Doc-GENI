;
; Paper Format Description File
;
; Filofax Paper, Dynodex #106
; (Same as Avery 41-256)
;

FORMAT "Filofax - #106 (petite)", 1025, 750, LANDSCAPE
	MARGINS 1, 0, 500, 0, 375, 0, 375, 0, 500, MIRROR
	FONTSIZE 1
	HINTS 2
	PAGESIZE 275, 625

