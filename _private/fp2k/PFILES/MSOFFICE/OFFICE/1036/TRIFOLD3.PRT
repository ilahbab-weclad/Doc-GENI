VIEW "Mensuel, vue en trois volets","Pleine page",,LANDSCAPE,3000,3000

;=======================================================================
; PAGE 1
;=======================================================================

;=======================================================================
; Header - Username, Date
;=======================================================================

OBJECT  ,TEXT,1010,0,1990,130
	STYLES			stySmallUserName
	VALUE			"&USERNAME"

OBJECT  ,TEXT,1010,100,1990,220
	STYLES			styDate
	VALUE			"&PRINTDATE"

;=======================================================================
; Left Pane - Timeframe and Schedule Box
;=======================================================================

OBJECT	,RECTANGLE,0,0,990,10
	OPTIONS			BLACK

OBJECT  ,TIMEFRAME,0,10,150,2935
	STYLES			stySmallTime

OBJECT  ,SCHEDULE,150,10,990,2935
	STYLES			stySmallApptText, stySmallApptText, stySmallHeading
	OPTIONS			3, 30, LOCATION, OVERFLOW, 10

;=======================================================================
; Right Pane - Other Appts, Events and To-Do Overflow
;=======================================================================

OBJECT	,RECTANGLE,2010,0,3000,10
	OPTIONS		BLACK

OBJECT  ,RECTANGLE,2010,10,3000,2935

OBJECT	,APPTS,0,0,0,0
	STYLES		stySmallApptText, stySmallTime, stySmallHeading
	RANGE		BEFORE,STARTTIME,OR,AFTER,ENDTIME
	OPTIONS		LOCATION, NONE, 1, 10, 0

OBJECT	,EVENTS,0,0,0,0
	STYLES		stySmallApptText, stySmallHeading
	OPTIONS		10, 1

OBJECT  ,TASKS,0,0,0,0
	STYLES			stySmallApptText, stySmallTaskDue, stySmallTaskCompleted, stySmallProjectText, stySmallHeading
	OPTIONS			NONE, 1, 10

OBJECT  ,OVERFLOW,2010,0,3000,2935
	OPTIONS			MINIMAL, CLEAR, 10
	STYLES			stySmallApptText

