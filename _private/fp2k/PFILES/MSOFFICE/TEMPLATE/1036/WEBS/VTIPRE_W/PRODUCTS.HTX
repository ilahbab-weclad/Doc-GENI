
<html>

<head>
<meta http-equiv="Content-Type" content="text/html; charset=windows-1252">
<meta http-equiv="Content-Language" content="fr">
<%if DoTheme EQ True%>
<meta name="Microsoft Theme" content="<%Theme%>">
<meta name="Microsoft Border" content="<%Border%>">
<%endif%>
<title><%ProductsPageTitle%></title>
</head>

<body <%if DoTheme EQ False%> stylesrc="<%PageStyleSrc%>" <%endif%> >

<%if DoTheme EQ False%>
<%if DoTopLogo EQ True%>
<!--webbot bot="Include" tag="BODY" u-include="<%LogoUrl%>" -->
<%endif%>
<%if StyleOption EQ 0%>
<h1><%ProductsPageTitle%></h1>
<%else%>
<p><!-- LOCALIZE the alt text in this image --><img src="<%BannerImgUrl%>" 
alt="[Bannière]" border="0" <%BannerImgSize%>> </p>
<%endif%>
<%if DoTopLinks EQ True%>
<!--webbot bot="Include" tag="BODY" u-include="<%NavbarUrl%>" -->
<%endif%>
<%if UnderConstructionOption EQ 0%>
<p><!-- LOCALIZE the alt text in this image --><img src="<%UnderconImgUrl%>" 
alt="[En construction]" border="0" <%UnderconImgSize%>></p>
<%endif%>
<%endif%>

<%if NumProducts GT 0%>

<%if DoTheme EQ False%>
<h2><!-- LOCALIZE this -->Produits</h2>
<%endif%>

<p><!-- LOCALIZE this comment bot --><!--webbot bot="PurpleText"
preview="Insérez ici une présentation générale de vos produits. Ajoutez des produits à la liste ci-dessous dans l'ordre qui vous semble le plus approprié, et créez-y des liens hypertexte vers leurs pages individuelles." --></p>

<!-- LOCALIZE the text in this definition list -->
<dl>
<%if NumProducts GT 0%>
    <dt><strong><a href="<%Prod1Url%>">Nom du produit 1</a></strong> </dt>
    <dd> <p> Description du produit 1...</p>
        <p> </p>
    </dd>
<%endif%>
<%if NumProducts GT 1%>
    <dt><strong><a href="<%Prod2Url%>">Nom du produit 2</a></strong> </dt>
    <dd> <p> Description du produit 2...</p>
        <p> </p>
    </dd>
<%endif%>
<%if NumProducts GT 2%> 
    <dt><strong><a href="<%Prod3Url%>">Nom du produit 3</a></strong> </dt>
    <dd> <p> Description du produit 3...</p>
        <p> </p>
    </dd>
<%endif%>
<%if NumProducts GT 3%>
    <dt><strong><a href="<%Prod4Url%>">Nom du produit 4</a></strong> </dt>
    <dd> <p> Description du produit 4...</p>
        <p> </p>
    </dd>
<%endif%>
<%if NumProducts GT 4%>
    <dt><strong><a href="<%Prod5Url%>">Nom du produit 5</a></strong> </dt>
    <dd> <p> Description du produit 5...</p>
        <p> </p>
    </dd>
<%endif%>
</dl>
<%endif%>

<%if NumServices GT 0%>
<h2>Services</h2>

<p><!-- LOCALIZE this comment bot --><!--webbot bot="PurpleText"
preview="Insérez ici une présentation générale de vos services. Ajoutez des services à la liste ci-dessous dans l'ordre qui vous semble le plus approprié, et créez-y des liens hypertexte vers leurs pages individuelles." --> </p>

<!-- LOCALIZE the text in this definition list -->
<dl>
<%if NumServices GT 0%>
    <dt><strong><a href="<%Serv1Url%>">Nom du service 1</a></strong> </dt>
    <dd> <p> Description du service 1...</p>
        <p> </p>
    </dd>
<%endif%>
<%if NumServices GT 1%>
    <dt><strong><a href="<%Serv2Url%>">Nom du service 2</a></strong> </dt>
    <dd> <p> Description du service 2...</p>
        <p> </p>
    </dd>
<%endif%>
<%if NumServices GT 2%>
    <dt><strong><a href="<%Serv3Url%>">Nom du service 3</a></strong> </dt>
    <dd> <p> Description du service 3...</p>
        <p> </p>
    </dd>
<%endif%>
<%if NumServices GT 3%>
    <dt><strong><a href="<%Serv4Url%>">Nom du service 4</a></strong> </dt>
    <dd> <p> Description du service 4...</p>
        <p> </p>
    </dd>
<%endif%>
<%if NumServices GT 4%>
    <dt><strong><a href="<%Serv5Url%>">Nom du service 5</a></strong> </dt>
    <dd> <p> Description du service 5...</p>
        <p> </p>
    </dd>
<%endif%>
</dl>
<%endif%>

<%if DoTheme EQ False%>
<%if DoBottomLinks EQ True%>
<!--webbot bot="Include" tag="BODY" u-include="<%NavbarUrl%>" -->
<%endif%>
<h5>
<%if DoBottomWebmasterAddress EQ True%>
<!-- LOCALIZE this line -->Envoyez un courrier électronique à <a
href="<%WebmasterUrl%>"><!--webbot
bot="Substitution" s-variable="<%WebVarWebmaster%>" --></a>pour toute question ou remarque concernant ce site Web.<br>
<%endif%>
<%if DoBottomCopyright EQ True%>
<!-- LOCALIZE this line -->Copyright © <%CurrentYear%> <!--webbot bot="Substitution"
s-variable="<%WebVarLongName%>" --><br>
<%endif%>
<%if DoBottomDateModified EQ True%>
<!-- LOCALIZE this line -->Dernière modification&nbsp;: 
<!--webbot bot="TimeStamp" s-type="EDITED"
s-format="%d %B %Y" -->
<%endif%>
</h5>
<%endif%>

</body>
</html>
