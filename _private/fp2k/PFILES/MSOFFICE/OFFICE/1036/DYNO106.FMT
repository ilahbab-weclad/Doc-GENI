	styApptTime,, 			"Arial",SWISS,5,5,5
	styApptText,,			"Arial",SWISS,5,5,5
	styHeading,,			"Arial",SWISS,6,6,6,BOLD
	styProjectText,,		"Arial",SWISS,6,6,6,BOLD
	styTaskDue,,			"Arial",SWISS,6,6,6,ITALIC
	styTaskCompleted,,		"Arial",SWISS,6,6,6,STRIKEOUT
	styListHeading,,		"Arial",SWISS,6,6,6,BOLD

	stySmallUserName,,		"Arial",SWISS,7,7,7,BOLD
	stySmallDate,,			"Arial",SWISS,4,4,4
	stySmallFooter,,		"Arial",SWISS,3,3,3
	stySmallCalendar,, 		"Arial",SWISS,4,4,4
	stySmallTime,, 			"Arial",SWISS,4,4,4
	stySmallApptTime,,		"Arial",SWISS,5,5,5
	stySmallApptText,, 		"Arial",SWISS,5,5,5
	stySmallHeading,,		"Arial",SWISS,6,6,6,BOLD
	stySmallProjectText,,	"Arial",SWISS,6,6,6,BOLD
	stySmallTaskDue,,	 	"Arial",SWISS,6,6,6,ITALIC
	stySmallTaskCompleted,,	"Arial",SWISS,6,6,6,STRIKEOUT
	stySmallListHeading,,	"Arial",SWISS,6,6,6,BOLD

